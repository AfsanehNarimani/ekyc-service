LOG_LEVEL=INFO

PASSIVE_LIVENESS_BACKEND=onnx
PASSIVE_LIVENESS_DECISION_MODE=report_only

KEYCLOAK_AUTH_ENABLED=true
KEYCLOAK_ISSUER=https://keycloak.example/realms/mobile-bank
KEYCLOAK_JWKS_URL=https://keycloak.example/realms/mobile-bank/protocol/openid-connect/certs
KEYCLOAK_ALLOWED_CLIENT_ID=mobile-bank-backend
KEYCLOAK_CLIENT_ID_CLAIM=azp
KEYCLOAK_ALGORITHM=RS256
KEYCLOAK_JWKS_CACHE_SECONDS=300
KEYCLOAK_HTTP_TIMEOUT_SECONDS=5.0
KEYCLOAK_CLOCK_SKEW_SECONDS=10

MAX_CONCURRENT_VERIFICATIONS=2
CAPACITY_RETRY_AFTER_SECONDS=3

INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_ROOT_DIR=/models/insightface
INSIGHTFACE_DETECTION_MODEL_FILENAME=det_10g.onnx
